class Solution {
public:
    long long countSubarrays(vector<int>& nums, long long k) {
        int n = nums.size();
        long long sum = 0, cnt = 0;
        int start = 0, end = 0;

        while (end < n) {
            sum += nums[end];

            while (start <= end && sum * (end - start + 1) >= k) {
                sum -= nums[start];
                start++;
            }

            cnt += (end - start + 1);
            end++;
        }

        return cnt;
    }
};
