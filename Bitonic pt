
class Solution {
  public:
    int findMaximum(vector<int> &arr) {
        int n=arr.size();
       int st=0,end=n-1;
      
       while(st<=end)
       {
          int mid=st+end/2;
          if(arr[mid-1]<arr[mid] && arr[mid]>arr[mid+1])
          {
              return arr[mid];
          }
          else if(arr[mid]<arr[mid+1]){
              st++;
          }
          else {
              end--;
          }
         if(mid==0)
          {
              if(arr[0]>arr[1])return arr[0];
              else return arr[1];
          }
          else if(mid==n-1)
          {
              if(arr[mid]>arr[mid-1])return arr[mid];
              else return arr[mid-1];
          
          }
       }
       return -1;
        
    }
};

