class Solution {
public:
    long long sumSubstrings(string &s) {
        int n = s.length();
        long long totalSum = 0;
        long long prev = 0;

        for (int i = 0; i < n; i++) {
            int num = s[i] - '0';
            prev = prev * 10 + num * (i + 1);  // formula: prev = prev * 10 + digit * (i+1)
            totalSum += prev;
        }

        return totalSum;
    }
};
