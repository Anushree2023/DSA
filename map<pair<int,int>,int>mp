class Solution {
public:
    int numEquivDominoPairs(vector<vector<int>>& domi) {
        int cnt = 0;
        int n = domi.size();
        map<pair<int, int>, int> mp;
        for (auto i : domi) {
            pair<int, int> p = {min(i[0], i[1]), max(i[0], i[1])};
            mp[p]++;
        }
        for (auto i : mp) {
            int val = i.second;
            if (val >= 2) {
                cnt += val * (val - 1) / 2;
            }
        }
        return cnt;
    }
};
