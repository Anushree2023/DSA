class Solution {
public:
    vector<int> findEvenNumbers(vector<int>& nums) {
        int n = nums.size();
        vector<int> ans;
        set<int> se;
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                for (int k = 0; k < n; k++) {
                    if( i!=j && j!=k && i!=k && nums[i]!=0)
                    {
                    int  s = nums[i]*100+nums[j]*10+nums[k];
                  
                    if ( s % 2 == 0  && se.count(s) == 0  ) {
                        se.insert(s);
                        ans.push_back(s);
                    }
                    }
                }
            }
        }
        sort(ans.begin(),ans.end());
        return ans;
    }
};
